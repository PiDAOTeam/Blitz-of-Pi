NODE_ENV=production

GAME_WEB_PORT=5173
ADMIN_WEB_PORT=5174
API_PORT=3000
REALTIME_PORT=3001

VITE_API_BASE_URL=https://blitzapi.hashpi.app
VITE_REALTIME_BASE_URL=wss://blitzapi.hashpi.app/ws/

API_BASE_URL=https://blitzapi.hashpi.app
REALTIME_BASE_URL=wss://blitzapi.hashpi.app/ws/

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=blitzhashpi
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=blitzhashpi
# MySQL 连接池上限。并发匹配/结算多时可调大，普通服务器建议 20-40。
MYSQL_CONNECTION_LIMIT=20

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SESSION_SECRET=change_me_to_a_long_random_secret
REALTIME_SETTLEMENT_SECRET=change_me_to_same_long_random_secret
# 对局结束后的结算并发数。值越大结算越快，但更容易产生数据库锁冲突，建议 2-4。
SETTLEMENT_CONCURRENCY=2
API_INTERNAL_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=https://blitz.hashpi.app,https://blitzadmin.hashpi.app,https://blitzapi.hashpi.app,https://sandbox.minepi.com

PI_APP_SLUG=blitz-of-pi
PI_API_KEY=change_me
PI_SANDBOX=false

# HashPi 开放资产网关。生产环境只填写真实密钥，不要提交到代码仓库。
ASSET_GATEWAY_ENABLED=false
ASSET_GATEWAY_BASE_URL=https://hash.pios.co/api.php?s=plugins/index/pluginsname/assetgateway/pluginscontrol/asset/pluginsaction
ASSET_GATEWAY_APP_KEY=change_me
ASSET_GATEWAY_APP_SECRET=change_me
ASSET_GATEWAY_TIMEOUT_MS=8000
