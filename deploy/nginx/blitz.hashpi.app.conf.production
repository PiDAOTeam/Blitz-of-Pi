server {
    listen 80;
    server_name blitz.hashpi.app;

    root /www/wwwroot/blitz.hashpi.app;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }
}

