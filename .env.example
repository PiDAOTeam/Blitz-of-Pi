NODE_ENV=development

GAME_WEB_PORT=5173
ADMIN_WEB_PORT=5174
API_PORT=3000
REALTIME_PORT=3001

API_BASE_URL=http://localhost:3000
REALTIME_BASE_URL=ws://localhost:3001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=blitzhashpi
# MySQL 连接池上限。并发匹配/结算多时可调大，普通服务器建议 20-40。
MYSQL_CONNECTION_LIMIT=20

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SESSION_SECRET=change_me_to_a_long_random_secret
REALTIME_SETTLEMENT_SECRET=change_me_to_same_long_random_secret
# 对局结束后的结算并发数。值越大结算越快，但更容易产生数据库锁冲突，建议 2-4。
SETTLEMENT_CONCURRENCY=2
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://sandbox.minepi.com

PI_APP_SLUG=blitz-of-pi
PI_PLATFORM_API_BASE=https://api.minepi.com
PI_SANDBOX=true

# 自动出款仅在确认 Pi 钱包和风控流程后启用；本地开发通常留空。
PI_PAYOUT_HORIZON_URL=
PI_PAYOUT_NETWORK_PASSPHRASE=Pi Network
PI_PAYOUT_SOURCE_SECRET=
PI_PAYOUT_SOURCE_PUBLIC=
AUTO_PAYOUT_BATCH_SIZE=10
AUTO_PAYOUT_STALE_MINUTES=10

# HashPi 资产网关。本地默认关闭。
ASSET_GATEWAY_ENABLED=false
ASSET_GATEWAY_BASE_URL=https://hash.pios.co/api.php?s=plugins/index/pluginsname/assetgateway/pluginscontrol/asset/pluginsaction
ASSET_GATEWAY_APP_KEY=change_me
ASSET_GATEWAY_APP_SECRET=change_me
ASSET_GATEWAY_TIMEOUT_MS=8000

# API 结算任务并发。生产建议 1-2，避免钱包结算锁冲突。
API_SETTLEMENT_CONCURRENCY=1
